{
  "extends": "../tsconfig.json",
  "compilerOptions": {
    "noUnusedLocals": true,
    "moduleResolution": "bundler",
    "sourceMap": true,
    "jsx": "preserve",
    "resolveJsonModule": true,
    "jsxImportSource": "solid-js",
    "preserveSymlinks": true,
    "types": [
      "@types/node"
    ]
  },
}
